# ============================================================
# 数据库配置模板
# 使用方法：复制本文件为 .env，填入本机真实值
#   copy .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库
# ============================================================

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=flask_douban_comment

# 爬虫侧使用的库（scrapy/douban/database.py）
MYSQL_DATABASE_SPIDER=flask_douban_comment

# 豆瓣爬虫会话
# DOUBAN_COOKIE 优先，同时兼容历史变量名 COOKIE
DOUBAN_COOKIE=
# 填写复制 Cookie 时所用浏览器的 navigator.userAgent
DOUBAN_USER_AGENT=Flask-Vue-LSTM-Scrapy/1.0 (learning project)

# 海报持久化（相对路径始终以项目根目录解析）
POSTER_STORAGE_ROOT=data/covers
POSTER_PUBLIC_PREFIX=/api/media/covers

# 可选的合规海报来源：TMDB API Read Access Token（Bearer Token）
# 申请地址：https://www.themoviedb.org/settings/api
TMDB_API_READ_TOKEN=
TMDB_LANGUAGE=zh-CN
TMDB_IMAGE_SIZE=w500

# Flask 服务配置
FLASK_HOST=127.0.0.1
FLASK_PORT=8080
FLASK_DEBUG=True
SECRET_KEY=change_me_in_production

# 深度学习情感分析
# 可选：cpu / gpu
DL_DEVICE=cpu
DEEPLEARNING_MODEL=deeplearning/checkpoints/final.pdparams
DEEPLEARNING_VOCAB=deeplearning/vocab.json

# 第三方服务（按需填写）
ALIPAY_APP_ID=
ALIPAY_NOTIFY_URL=
ALIPAY_APP_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION=cn-hangzhou
